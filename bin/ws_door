#!/usr/bin/env ruby
# The browsers' door between nginx and zenohd's ws/ listener (G1): a plain
# TCP relay that gives every connection a lifetime. nginx cannot: its proxy
# timeouts only close a connection that has been idle, and a Zenoh session
# is never idle (keep-alives every few seconds). So nginx (which ends TLS and
# checks the pass, deploy/vps/nginx/asterism-router.conf) hands each
# WebSocket to this relay, which forwards the bytes both ways to zenohd and
# closes both sides when the connection is MAX seconds old, or earlier when
# the pass it came in with closes: nginx hands on the console's answer as
# X-Asterism-Until (Unix seconds; G1.5b). A pass belongs to the page that
# used it first and lets that page connect again while it is open (after
# the router restarts, say), so a connection never outlives its pass. A
# browser that is still there then needs a fresh pass.
#
# When zenohd is not there (it restarts, an apply), the door answers the
# browser with a plain 503 itself instead of closing the connection: nginx
# writes the request line, pass and all, into its error log when an
# upstream closes without an answer, and never for an answer. The page
# then tries again by itself.
#
# It also logs, per connection, the path of the request nginx forwarded and
# whether it carried a query (it must not: nginx drops the pass before
# proxying). The query itself is never logged.
#
#   WS_DOOR_LISTEN        0.0.0.0:7451
#   WS_DOOR_UPSTREAM      zenohd:7449
#   WS_DOOR_MAX_SECONDS   14400 (4 hours)
#
# The rooms' door (G2, lib/relay/room_door.rb, docs/rooms.md) runs in the
# same process when WS_DOOR_ROOM_LISTEN is set: a browser in a room comes
# with the room's key (wss://<router>/room?t=...), which it checks before
# it connects to zenohd's mutual-TLS port with the certificate of the
# page's seat.
#
#   WS_DOOR_ROOM_LISTEN       0.0.0.0:7452 (unset: no rooms)
#   WS_DOOR_ROOM_UPSTREAM     zenohd:7448 (zenohd's mutual-TLS listener)
#   WS_DOOR_ROOM_TLS_NAME     the name in zenohd's certificate (default: the upstream's host)
#   WS_DOOR_ROOMS_FILE        /rooms/rooms.json (the console writes it: Relay::RoomFiles)
#   WS_DOOR_ROOM_CERTS        /rooms/certs (room-<slot>-s<seat>.pem / .key, ca.pem)
#   WS_DOOR_ROOM_TOTAL        48  room connections at once, all rooms together
#   WS_DOOR_ROOM_PER_ROOM     16  per room (a room's own limit may be lower)
#   WS_DOOR_ROOM_MAX_MESSAGE  65535 bytes (one WebSocket message, one Zenoh batch)
#   WS_DOOR_STATUS_LISTEN     0.0.0.0:7453 (GET /status: the counts, for the console; unset: none)
#
# Browsers the router tells apart (T8, lib/relay/browser_door.rb, docs/g1_5.md):
# the console's answer to the pass check says whose page it is
# (X-Asterism-Browser, signed with the console's key in the browsers' store);
# the user's own page goes to zenohd's mutual-TLS port with the user's
# certificate (browsers/wasm-<handle>.pem) when the router's configuration
# lets it in; a page opened later takes the name over from an earlier one
# (T8c: the earlier page's connections are closed and it comes back through
# ws/, told so); the others to ws/ as before. A page that asks (the browser build from T8 on) is told which, in a
# Text message before anything of Zenoh.
#
#   WS_DOOR_BROWSERS_DIR      /rooms/browsers (the console writes it: Relay::BrowserCerts;
#                             "-": every page to ws/)
#   WS_DOOR_BROWSER_UPSTREAM  WS_DOOR_ROOM_UPSTREAM, else zenohd:7448 (zenohd's mutual-TLS listener)
#   WS_DOOR_BROWSER_TLS_NAME  WS_DOOR_ROOM_TLS_NAME, else the upstream's host
#
# Seats (0.3.0, docs/rooms.md "Seats"): POST /room/seat on the same listener
# gives a page a seat, and the room's WebSocket connects with the seat's
# certificate (room-<slot>-s<seat>).
#
#   WS_DOOR_SEATS_FILE        /seats/seats.json (the seats' table, SHA-256 of the pages' secrets
#                             only; a volume the door may write; unset: kept in memory)
#   WS_DOOR_SEAT_IDLE         1800 (seconds without a connection after which a seat may be
#                             given to another page when every seat is taken)
require "socket"

LISTEN = ENV.fetch("WS_DOOR_LISTEN", "0.0.0.0:7451")
UPSTREAM = ENV.fetch("WS_DOOR_UPSTREAM", "zenohd:7449")
MAX_SECONDS = Float(ENV.fetch("WS_DOOR_MAX_SECONDS", "14400"))
HEAD_MAX = 16 * 1024
$stdout.sync = true

def log(msg) = puts("#{Time.now.utc.strftime('%Y-%m-%dT%H:%M:%S')} ws_door: #{msg}")

def split_hostport(s)
  host, _, port = s.rpartition(":")
  [ host.delete_prefix("[").delete_suffix("]"), Integer(port) ]
end

# Reads the request head (up to the blank line) without reading past it.
def read_head(io)
  head = +""
  head << io.readpartial(1) until head.end_with?("\r\n\r\n") || head.bytesize > HEAD_MAX
  head
end

def serve(n, client)
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  head = read_head(client)
  line = head.lines.first.to_s.strip
  target = line.split(" ")[1].to_s
  path = target.split("?", 2).first
  query = target.include?("?") ? (target.include?("pass=") ? " WITH A QUERY CARRYING pass=" : " with a query") : ""
  from = head[/^X-Forwarded-For:\s*([^\r\n]+)/i, 1] || "?"
  limit = lifetime(head)
  word = BROWSERS&.word(head)
  why = word ? BROWSERS.claim(word) : nil
  if word && why.nil?
    if (tls = BROWSERS.connect(word[:node]))
      log("##{n} open from #{from}: #{line.split(' ')[0]} #{path}#{query}, as #{word[:node]} with its certificate " \
          "(pass #{word[:pass]}), for #{limit.round} s")
      reason = BROWSERS.serve(client, head, tls, word, limit)
      secs = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).round(1)
      return log("##{n} closed after #{secs} s (#{reason})")
    end
    why = "zenohd's mutual-TLS port did not take #{word[:node]}'s certificate"
  end
  begin
    upstream = TCPSocket.new(*split_hostport(UPSTREAM))
  rescue SystemCallError, SocketError => e
    unavailable(client)
    return log("##{n} from #{from}: zenohd is not there (#{e.class}); answered 503")
  end
  upstream.write(head.gsub(/^X-Asterism-Browser:[^\r\n]*\r\n/i, ""))
  shared = word ? " (shared: #{why})" : ""
  log("##{n} open from #{from}: #{line.split(' ')[0]} #{path}#{query}, for #{limit.round} s#{shared}")
  answered = word && word[:notice] ? tell_shared(client, upstream, why) : false
  reason = relay(client, upstream, t0, limit, answered: answered)
  secs = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).round(1)
  log("##{n} closed after #{secs} s (#{reason})")
rescue StandardError => e
  log("##{n} #{e.class}: #{e.message}")
ensure
  [ client, upstream ].each { |s| s&.close rescue nil }
end

# A page that reads the door's notice (T8) on the shared ws/: zenohd's
# answer to the upgrade goes on as it is, then the notice (a Text frame from
# the door) before zenohd's first batch. Returns whether zenohd answered.
def tell_shared(client, upstream, why)
  answer = read_head(upstream)
  client.write(answer)
  return false unless answer.start_with?("HTTP/1.1 101")
  client.write(Relay::BrowserDoor.text_frame(Relay::BrowserDoor.notice(false, why: why)))
  true
rescue EOFError, IOError, SystemCallError
  false
end

# This connection's lifetime in seconds: MAX_SECONDS, or less when the pass
# closes sooner (X-Asterism-Until from nginx).
def lifetime(head)
  until_s = head[/^X-Asterism-Until:\s*(\d+)\s*$/i, 1]
  return MAX_SECONDS unless until_s
  [ [ Integer(until_s) - Time.now.to_f, 0.0 ].max, MAX_SECONDS ].min
end

# A plain answer to the browser (nginx passes it on and logs no error).
def unavailable(client)
  client.write("HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
rescue IOError, SystemCallError
  nil
end

def relay(a, b, t0, limit = MAX_SECONDS, answered: false)
  peer = { a => b, b => a }
  # answered: zenohd has sent something (its 101 first)
  loop do
    left = limit - (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0)
    return "lifetime #{limit.round} s reached" if left <= 0
    ready, = IO.select([ a, b ], nil, nil, left)
    next unless ready
    ready.each do |s|
      data = s.readpartial(64 * 1024)
      answered = true if s == b
      peer[s].write(data)
    rescue EOFError, IOError, SystemCallError
      return "closed by the browser side" if s == a
      # zenohd closed before it answered the upgrade (it is starting).
      unavailable(a) unless answered
      return answered ? "closed by zenohd" : "closed by zenohd before it answered; answered 503"
    end
  end
end

if ENV["WS_DOOR_ROOM_LISTEN"].to_s != ""
  require_relative "../lib/relay/room_door"
  Relay::RoomDoor.new(
    listen: ENV["WS_DOOR_ROOM_LISTEN"],
    upstream: ENV.fetch("WS_DOOR_ROOM_UPSTREAM", "zenohd:7448"),
    tls_name: ENV["WS_DOOR_ROOM_TLS_NAME"].to_s.empty? ? nil : ENV["WS_DOOR_ROOM_TLS_NAME"],
    rooms_file: ENV.fetch("WS_DOOR_ROOMS_FILE", "/rooms/rooms.json"),
    certs_dir: ENV.fetch("WS_DOOR_ROOM_CERTS", "/rooms/certs"),
    status_listen: ENV["WS_DOOR_STATUS_LISTEN"].to_s.empty? ? nil : ENV["WS_DOOR_STATUS_LISTEN"],
    total: Integer(ENV.fetch("WS_DOOR_ROOM_TOTAL", "48")),
    per_room: Integer(ENV.fetch("WS_DOOR_ROOM_PER_ROOM", "16")),
    max_message: Integer(ENV.fetch("WS_DOOR_ROOM_MAX_MESSAGE", "65535")),
    seats_file: ENV["WS_DOOR_SEATS_FILE"].to_s.empty? ? nil : ENV["WS_DOOR_SEATS_FILE"],
    seat_idle: Float(ENV.fetch("WS_DOOR_SEAT_IDLE", "1800")),
    log: ->(m) { log(m) }
  ).start
end

BROWSERS_DIR = ENV.fetch("WS_DOOR_BROWSERS_DIR", "/rooms/browsers")
BROWSERS = if BROWSERS_DIR == "-"
  nil
else
  require_relative "../lib/relay/browser_door"
  upstream = ENV["WS_DOOR_BROWSER_UPSTREAM"].to_s.empty? ? ENV.fetch("WS_DOOR_ROOM_UPSTREAM", "zenohd:7448") : ENV["WS_DOOR_BROWSER_UPSTREAM"]
  name = [ ENV["WS_DOOR_BROWSER_TLS_NAME"], ENV["WS_DOOR_ROOM_TLS_NAME"] ].find { _1.to_s != "" }
  Relay::BrowserDoor.new(upstream: upstream, tls_name: name, dir: BROWSERS_DIR, log: ->(m) { log(m) })
end

server = TCPServer.new(*split_hostport(LISTEN))
log("listening on #{LISTEN}, to #{UPSTREAM}, lifetime #{MAX_SECONDS.round} s; " +
    (BROWSERS ? "browsers with a certificate (#{BROWSERS_DIR}) to #{BROWSERS.upstream}" : "every browser to ws/"))
n = 0
loop do
  client = server.accept
  n += 1
  Thread.new(n, client) { |i, c| serve(i, c) }
end
