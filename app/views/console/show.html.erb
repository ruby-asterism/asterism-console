<% content_for(:title, "Asterism Console") %>
<div class="console" data-controller="console"
     data-console-state-value="<%= @state.as_payload(rooms: @rooms).to_json %>"
     data-console-watches-value="<%= @watches.map(&:as_payload).to_json %>"
     data-console-admin-value="<%= current_user&.admin? ? "true" : "false" %>"
     data-console-rooms-value="<%= @rooms ? "true" : "false" %>">
  <header class="bar">
    <h1>Asterism Console</h1>
    <div class="bridge" data-console-target="bridge">bridge: waiting</div>
    <%= render "shared/nav" %>
  </header>

  <nav class="layers" aria-label="Layers">
    <label><input type="checkbox" data-layer="infra" data-action="console#toggleLayer" checked> Routers</label>
    <label title="Draw each Zenoh session as a point between the router and the nodes (for finding out why something does not connect)"><input type="checkbox" name="session_points" data-action="console#toggleSessionPoints"> Sessions as points</label>
    <label><input type="checkbox" data-layer="asterism" data-action="console#toggleLayer" checked> Asterism</label>
    <label><input type="checkbox" data-layer="ros" data-action="console#toggleLayer" checked> ROS 2</label>
    <label title="Marks the nodes and routers by the relay registry, and shows its names that are not connected (remembered by this browser)"><input type="checkbox" data-layer="registry" data-action="console#toggleLayer"> Relay registry</label>
    <% if @rooms %>
      <label title="The open rooms, each a frame holding the nodes in it (admins only; watched, not callable)"><input type="checkbox" data-layer="rooms" data-action="console#toggleLayer" checked> Rooms</label>
    <% end %>
    <span class="sep" aria-hidden="true"></span>
    <label title="ROS 2 topics as nodes between their publishers and subscribers, instead of edges">
      <input type="checkbox" name="topic_nodes" data-action="console#toggleTopicNodes"> Topics as nodes</label>
    <label title="Topics every rclcpp node has">
      <input type="checkbox" name="hide_debug" data-action="console#toggleDebug" checked> Hide /rosout, /parameter_events</label>
    <label><input type="checkbox" name="show_hz" data-action="console#toggleHz" checked> Hz on topics</label>
    <label title="The bridge subscribes to every ROS 2 topic while this is ticked (each topic's messages then reach the bridge)">
      <input type="checkbox" name="measure_all" data-action="console#toggleMeasure"> Measure all topics</label>
    <span class="hint" data-console-target="rateStatus"></span>
    <button type="button" data-action="console#relayout">Lay out again</button>
    <span class="counts" data-console-target="counts"></span>
  </nav>

  <%# The graph and its Details side by side, the watched keys in a panel
      below both; the borders between them can be dragged (panes_controller). %>
  <main class="body graph-body" data-controller="panes">
    <div class="upper">
      <section class="graph" data-console-target="graph" aria-label="Network graph"></section>
      <div class="splitter splitter-x" role="separator" aria-orientation="vertical" aria-label="Resize the details"
           title="Drag to change the width of the details" data-action="pointerdown->panes#startSide"></div>
      <aside class="side" data-panes-target="side">
        <section class="panel details" data-console-target="details">
          <h2>Details</h2>
          <p class="hint">Click a node or a topic edge in the graph.</p>
        </section>
      </aside>
    </div>
    <div class="splitter splitter-y" role="separator" aria-orientation="horizontal" aria-label="Resize the watched keys"
         title="Drag to change the height of the watched keys" data-action="pointerdown->panes#startDock"></div>
    <section class="dock watches empty" data-panes-target="dock" data-console-target="dock" aria-label="Watched keys">
      <div class="dock-head">
        <button type="button" class="small dock-toggle" data-action="panes#toggleDock" data-panes-target="toggle"
                aria-expanded="true" aria-label="Collapse the watched keys">&#9662;</button>
        <h2>Watch a key</h2>
        <span class="hint dock-count" data-console-target="watchCount">none watched</span>
        <form data-action="console#addWatch" class="watch-form">
          <input type="text" name="key" placeholder="fmrb/test/out" aria-label="Key expression" required>
          <button type="submit">Watch</button>
        </form>
      </div>
      <p class="error" data-console-target="watchError"></p>
      <div class="watch-list" data-console-target="watchList"></div>
    </section>
  </main>

  <footer class="legend" data-console-target="legend"></footer>
</div>
