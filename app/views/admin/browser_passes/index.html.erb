<% content_for(:title, "Browser passes - Asterism Console") %>
<section class="card">
  <h2>Every browser pass</h2>
  <% if @passes.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>#</th><th>User</th><th>Node</th><th>Made</th><th>Until</th><th>Status</th><th>Connections</th><th>Last used</th><th>Refused</th><th></th></tr></thead>
      <tbody>
        <% @passes.each do |p| %>
          <tr>
            <td><%= p.id %></td>
            <td><%= p.user.email_address %></td>
            <td><%= p.node ? tag.code(p.node) : "-" %></td>
            <td class="nowrap"><%= when_text(p.created_at) %> from <%= p.created_ip %></td>
            <td class="nowrap"><%= when_text(p.expires_at) %></td>
            <td><span class="badge <%= p.status == 'live' ? 'ok' : 'bad' %>"><%= p.status %></span>
              <% if p.revoked_by %><br><span class="hint">by <%= p.revoked_by.email_address %></span><% end %></td>
            <td><%= p.uses %></td>
            <td class="nowrap"><%= p.last_used_at ? "#{when_text(p.last_used_at)} from #{p.last_used_ip}" : "-" %></td>
            <td><%= p.refused %></td>
            <td><%= button_to "Revoke", revoke_browser_pass_path(p), method: :patch, class: "small" if p.status == "live" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
