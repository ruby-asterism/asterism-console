<% content_for(:title, "Rooms - Asterism Console") %>
<section class="card">
  <h2>Rooms</h2>
  <p>A room is a key space of its own on the cloud router (<code>room/&lt;slot&gt;/**</code>) that anyone with its link
    joins from a browser, without an account, until it ends. The link holds the room's key: give it to the people you
    invite. Inside, everyone with the link is alike; what they may do there is up to the app. Nothing in a room reaches
    the registered routers and nodes, and nothing of theirs reaches the room.</p>
  <%= render "door", door: @door %>
  <%= render "games", games: @games %>
  <% if @ready.empty? %>
    <p class="error">No room slot is ready: run <code>bin/asterism setup</code> (it makes the seats' certificates), then
      apply in Members so that the cloud router lets them in.</p>
  <% end %>
</section>

<section class="card">
  <h2>Slots and seats</h2>
  <% per_slot = Relay::Settings.room_seats %>
  <% taken = @door ? @busy.values.sum { @door.dig("seats", _1.uid).to_i } : nil %>
  <p><%= @slots.size %> slots of <%= per_slot %> seats (<code>ASTERISM_ROOM_SLOTS</code>, <code>ASTERISM_ROOM_SEATS</code>).
    In use: <%= @busy.size %> of <%= @slots.size %> slots hold an open room,
    <%= taken.nil? ? "? (the door does not answer)" : taken %> of <%= @busy.size * per_slot %> seats of those rooms are
    taken.</p>
  <p class="hint">Each page in a room has a seat: a certificate of the rooms' own (<code>room-01-s03</code>, its node
    <code><%= Relay::Settings.seat_node("01", "03") %></code>), made by <code>bin/asterism setup</code> and kept in the
    rooms' store, not in the registry. In the store: <%= @seat_certs["good"] %> of <%= @slots.size * per_slot %> good
    <% if @seat_certs["until"] %>(the first ends <%= when_text(@seat_certs["until"]) %>)<% end %>.
    The cloud router lets in <%= @seats_in_config.values.sum %> (its configuration; an apply after setup brings in new ones).</p>
  <% if @slots.any? %>
    <table class="list">
      <thead><tr><th>Slot</th><th>Room</th><th>Seats in the router</th><th>Seats taken</th><th>Connections</th></tr></thead>
      <tbody>
        <% @slots.each do |s| %>
          <% room = @busy[s] %>
          <tr>
            <td><code><%= s %></code></td>
            <td><%= room ? link_to(room.name, admin_room_path(room)) : tag.span(@ready.include?(s) ? "free" : "not ready", class: "hint") %></td>
            <td><%= @seats_in_config.fetch(s, 0) %> of <%= per_slot %></td>
            <td><%= room ? (@door ? (@door.dig("seats", room.uid) || 0) : "?") : "-" %></td>
            <td><%= @door ? (@door.dig("slots", s) || 0) : "?" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="card">
  <h2>Make a room</h2>
  <%= form_with url: admin_rooms_path, scope: :room, class: "grid-form", data: { turbo: false } do |f| %>
    <label>Name <%= f.text_field :name, required: true, maxlength: 60, placeholder: "Othello on Friday" %></label>
    <label>Opens <span class="field-help">The app the link starts<% if @games_apps.any? %>. A room that opens
        <%= safe_join(@games_apps.map { tag.code(_1) }, ", ") %> gets a table from the game host<% end %>.</span>
      <%= f.select :app, [ [ "Nothing (the page's own start)", "" ] ] + @apps, selected: @apps.first&.last %></label>
    <label>Or another app <span class="field-help">A path on the page, e.g. /app/test/othello.app.rb (over the
        choice above).</span>
      <%= f.text_field :app_other, placeholder: "/app/test/othello.app.rb" %></label>
    <label>Hours <span class="field-help">How long it is open: <%= @hours %> unless you say, at most <%= @max_hours %>.
        Its links stop working then and the door closes its connections.</span>
      <%= f.number_field :hours, value: @hours, min: 0.25, max: @max_hours, step: 0.25 %></label>
    <label>Connections <span class="field-help">At once, at most <%= Relay::Settings.room_max_connections %>. One browser
        page is one connection (a table of 4 and 12 watching is 16).</span>
      <%= f.number_field :max_connections, value: @room.max_connections, min: 1, max: Relay::Settings.room_max_connections %></label>
    <div class="wide"><%= f.submit "Make the room", disabled: @ready.empty? %></div>
  <% end %>
</section>

<section class="card">
  <h2>Every room</h2>
  <% if @rooms.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>Name</th><th>Slot</th><th>Opens</th><th>Made</th><th>Until</th><th>Status</th><th>Connections</th><th>Seats taken</th><% if @games_on %><th>Tables</th><% end %><th>Links</th></tr></thead>
      <tbody>
        <% @rooms.each do |r| %>
          <tr>
            <td><%= link_to r.name, admin_room_path(r) %></td>
            <td><code><%= r.slot %></code></td>
            <td><%= r.app.present? ? tag.code(r.app) : "-" %></td>
            <td class="nowrap"><%= when_text(r.created_at) %><% if r.created_by %><br><span class="hint"><%= r.created_by.email_address %></span><% end %></td>
            <td class="nowrap"><%= when_text(r.closed_at || r.expires_at) %></td>
            <td><span class="badge <%= r.open? ? 'ok' : 'bad' %>"><%= r.status %></span></td>
            <td><%= r.open? ? (@door ? "#{@door.dig('rooms', r.uid) || 0} / #{r.max_connections}" : "? / #{r.max_connections}") : "-" %></td>
            <td><%= r.open? ? (@door ? (@door.dig("seats", r.uid) || 0) : "?") : "-" %></td>
            <% if @games_on %><td><%= room_tables_text(r, @games, @games_apps) %></td><% end %>
            <td><%= r.links_made %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
