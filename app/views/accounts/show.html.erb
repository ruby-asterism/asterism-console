<% content_for(:title, "Account - Asterism Console") %>
<section class="card">
  <h2>Account</h2>
  <dl class="facts">
    <dt>Email address</dt><dd><%= @user.email_address %></dd>
    <dt>Role</dt><dd><%= @user.admin? ? "admin (edits call permissions and the relay registry)" : "user" %></dd>
  </dl>
</section>

<section class="card" id="handle">
  <h2>Handle</h2>
  <p>A short name for you on the network: a browser page you open from the console joins it as
    <code><%= Relay::Settings.browser_node_prefix %>&lt;handle&gt;</code>, which every node sees (a second page at the same time
    adds <code>_2</code> and so on). Lower case letters, digits and single hyphens, <%= User::HANDLE_MIN %> to
    <%= User::HANDLE_MAX %> characters, starting with a letter; nobody else may have it.</p>
  <% if @user.handle.blank? %>
    <p><strong>You have no handle yet.</strong> Choose one to open the browser build.</p>
  <% end %>
  <%= form_with url: handle_account_path, method: :patch, class: "row" do |f| %>
    <%= f.text_field :handle, value: @user.handle_in_database, required: true, minlength: User::HANDLE_MIN,
                     maxlength: User::HANDLE_MAX, pattern: "[A-Za-z]([A-Za-z0-9]|-(?=[A-Za-z0-9]))*", autocomplete: "off", autocapitalize: "none",
                     spellcheck: false, "aria-label": "Handle" %>
    <%= f.submit(@user.handle.blank? ? "Choose" : "Change") %>
  <% end %>
  <% if @user.handle.present? %>
    <p class="hint">Changing it: pages open now keep the old name until they close. The old name stays reserved for you for
      <%= (User::HANDLE_HOLD / 1.day).round %> days (nobody else can take it meanwhile).</p>
  <% end %>
</section>

<section class="card">
  <h2>Two-factor sign-in (TOTP)</h2>
  <% if @user.otp_enabled? %>
    <p>On since <%= l(@user.otp_enabled_at, format: :long) %>. Signing in asks for a code from your authenticator app.</p>
    <%= form_with url: disable_otp_account_path, method: :delete, class: "row" do |f| %>
      <%= f.password_field :current_password, placeholder: "Current password", required: true, autocomplete: "current-password", "aria-label": "Current password" %>
      <%= f.submit "Turn off" %>
    <% end %>
  <% elsif @user.otp_secret.present? %>
    <p>Scan this code with your authenticator app, or type the secret into it (both are shown until you confirm), then type the code it shows.</p>
    <% turbo_exempts_page_from_cache # no snapshot of the secret for the back button %>
    <%= otp_qr_svg(@user.otp_uri) %>
    <dl class="facts">
      <dt>Secret</dt><dd><code><%= @user.otp_secret.scan(/.{1,4}/).join(" ") %></code></dd>
      <dt>URI</dt><dd><code class="wrap"><%= @user.otp_uri %></code></dd>
    </dl>
    <%= form_with url: otp_confirm_account_path, class: "row" do |f| %>
      <%= f.text_field :code, placeholder: "123456", required: true, inputmode: "numeric", pattern: "[0-9]{6}", maxlength: 6, autocomplete: "one-time-code", "aria-label": "Code" %>
      <%= f.submit "Confirm" %>
    <% end %>
  <% else %>
    <p>Off. Turn it on to ask for a code from an authenticator app after the password.</p>
    <%= button_to "Turn on", start_otp_account_path %>
  <% end %>
</section>

<section class="card">
  <h2>Password</h2>
  <%= form_with url: password_account_path, method: :patch, class: "stack" do |f| %>
    <label>Current password <%= f.password_field :current_password, required: true, autocomplete: "current-password" %></label>
    <label>New password (12 characters or more) <%= f.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %></label>
    <label>New password again <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></label>
    <%= f.submit "Change the password" %>
  <% end %>
</section>
