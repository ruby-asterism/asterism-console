<% content_for(:title, "Call log - Asterism Console") %>
<section class="card">
  <h2>Call log</h2>
  <p>
    <%= params[:all].present? ? "Calls and meta reads" : "Calls" %> from the page, newest first (the last <%= CallsController::LIMIT %>).
    <%= params[:all].present? ? link_to("Calls only", calls_path) : link_to("Also the meta reads", calls_path(all: 1)) %>
  </p>
  <% if @rows.empty? %>
    <p class="hint">Nothing yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>When</th><th>Who</th><th>What</th><th>Arguments</th><th>Result</th><th>ms</th></tr></thead>
      <tbody>
        <% @rows.each do |r| %>
          <tr class="status-<%= r.status %>">
            <td class="nowrap"><%= l(r.created_at, format: "%Y-%m-%d %H:%M:%S") %></td>
            <td><%= r.user&.email_address || "(before sign-in existed)" %></td>
            <td><code><%= r.path %></code> <%= r.kind == "call" ? tag.code(r.method_name) : tag.span("meta", class: "hint") %></td>
            <td><code class="wrap"><%= r.args %></code></td>
            <td><span class="badge"><%= r.status %></span>
              <% if r.status == "ok" %><code class="wrap"><%= r.result.to_s.truncate(160) %></code>
              <% else %><%= [ (r.error_kind && "[#{r.error_kind}]"), r.error_class, r.error_message ].compact.join(" ").truncate(200) %><% end %></td>
            <td><%= r.took_ms %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="card" id="terminal">
  <h2>Terminal commands</h2>
  <p>
    Command lines typed in the <%= link_to "Terminal", terminal_path, data: { turbo: false } %>, newest first (the last <%= CallsController::LIMIT %>):
    what they read or called, how they ended, and the start of what they printed. Refused ones are kept too.
  </p>
  <% if @terminal.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>When</th><th>Who</th><th>Command</th><th>Kind</th><th>Result</th><th>ms</th></tr></thead>
      <tbody>
        <% @terminal.each do |t| %>
          <tr class="status-<%= { "ok" => "ok", "denied" => "denied", "failed" => "error" }.fetch(t.status, t.status) %>">
            <td class="nowrap"><%= l(t.created_at, format: "%Y-%m-%d %H:%M:%S") %></td>
            <td><%= t.user&.email_address || "(a removed user)" %></td>
            <td><code class="wrap"><%= t.line.truncate(300) %></code></td>
            <td><%= t.effect == "call" ? tag.strong("call") : (t.effect || "-") %>
              <% if t.effect == "call" && t.path %><code class="wrap"><%= t.path %> <%= t.method_name %></code><% end %></td>
            <td><span class="badge"><%= t.status %></span><%= " exit #{t.exit_code}" if t.exit_code %>
              <% if t.reason.present? %><span class="hint"><%= t.reason.truncate(200) %></span><% end %>
              <% if t.output.present? %><code class="wrap" title="<%= t.output %>"><%= t.output.squish.truncate(160) %></code><% end %></td>
            <td><%= t.took_ms %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="card" id="playbacks">
  <h2>Playbacks to the network</h2>
  <p>Recordings an admin played back onto the network (newest first). Playing in the page only sends nothing and is not listed.</p>
  <% if @playbacks.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>When</th><th>Who</th><th>Recording</th><th>Speed</th><th>Status</th><th>Sent</th><th>Not sent</th></tr></thead>
      <tbody>
        <% @playbacks.each do |p| %>
          <tr class="status-<%= p.status == "done" ? "ok" : p.status %>">
            <td class="nowrap"><%= l(p.created_at, format: "%Y-%m-%d %H:%M:%S") %></td>
            <td><%= p.user&.email_address %></td>
            <td><%= p.recording ? link_to(p.recording_name, recording_path(p.recording)) : "#{p.recording_name} (deleted)" %>
              <% if p.start_ns %><span class="hint">from <%= Time.zone.at(p.start_ns / 1_000_000_000r).strftime("%H:%M:%S.%L %Z") %></span><% end %></td>
            <td><%= p.speed %>x</td>
            <td><span class="badge"><%= p.status %></span> <%= p.error.to_s.truncate(160) %></td>
            <td><%= p.messages_sent %></td>
            <td class="hint"><%= p.skipped_value.map { |t, why| "#{t}: #{why}" }.join("; ").truncate(200) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
