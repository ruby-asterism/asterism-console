<%# The backups' warning (Admin > Relay and Users): the last backup failed or
    none ran for two days (lib/console_backup.rb, docs/install.md "Backups"). %>
<% if (w = backup_warning) %>
  <div class="apply-banner backup-warning" role="alert">
    <span>Backups: <%= w %></span>
    <span class="hint">docker compose logs backup; bin/asterism backups</span>
  </div>
<% end %>
