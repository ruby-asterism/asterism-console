<% content_for(:title, "Roles - Asterism Console") %>
<%= render "relay/peers/tabs" %>
<section class="card">
  <h2>Roles</h2>
  <p>A role is a name and the keys it allows, written as templates: <code>${node}</code> stands for each node a row
    speaks for (the nodes behind a router, or the row's own name). Rows of the registry pick roles; the cloud
    router's ACL is made from them when it is applied.</p>
  <% if @roles.empty? %>
    <p class="hint">No roles yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>Name</th><th>Rows</th><th>Browsers</th><th>Opens in a browser page</th></tr></thead>
      <tbody>
        <% @roles.each do |r| %>
          <tr>
            <td><%= link_to r.name, relay_role_path(r) %><br><span class="hint"><%= r.description %></span></td>
            <td><%= r.peers.any? ? r.peers.map(&:name).sort.join(", ") : tag.span("none", class: "hint") %></td>
            <td><%= r.for_browsers? ? (@browsers ? "yes" : "yes (no browsers are let in now)") : "-" %></td>
            <td><%= r.browser_app.present? ? tag.code(r.browser_app) : "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <p><%= link_to "Make a role", new_relay_role_path %></p>
</section>
