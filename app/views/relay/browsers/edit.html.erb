<% name = Relay::BrowserNode.base(@user) %>
<% content_for(:title, "#{name} - Asterism Console") %>
<%= render "relay/peers/tabs" %>
<section class="card">
  <h2><%= name %> <span class="hint">a user's browser</span></h2>
  <% if @user.errors.any? %><p class="error"><%= @user.errors.full_messages.to_sentence %></p><% end %>
  <%= form_with model: @user, scope: :user, url: relay_browser_path(@user), method: :patch, class: "grid-form" do |f| %>
    <fieldset class="wide files receivers">
      <legend>Receives files from (the page with the user's certificate keeps the list in its
        <code>/home/asterism/receive.toml</code>; the console sends it there)</legend>
      <%= render "relay/peers/receivers_fields", owner: @user, param: "user" %>
      <p class="hint">Each node chosen may call this browser's inbox
        (<code>asterism/<%= name %>/transfer/inbox/call/&lt;sender&gt;</code>, made on Apply), and the page takes what it
        sends when receiving is on there (the Receiving app, or <code>areceive on</code> in its Shell). The page takes the
        list, and receives, only while the door connects it with the user's certificate.</p>
    </fieldset>
    <fieldset class="wide files">
      <legend>Remote shell</legend>
      <label class="check"><%= f.check_box :rshell_from_console %> Remote shell from the console: the page lets the
        Terminal's <code>remote <%= name %></code> in (sent with the lists; the page's owner must also turn the remote
        shell on there). Who may use it is chosen per user under Users.</label>
    </fieldset>
    <fieldset class="wide roles">
      <legend>Roles of this browser (<%= link_to "what they allow", relay_roles_path %>)</legend>
      <% every = RelayRole.where(for_browsers: true).order(:name).pluck(:name) %>
      <% picks = RelayRole.where(for_browsers: false).order(:name) %>
      <p class="hint">Every browser has <%= every.empty? ? "no role" : every.map { tag.code(_1) }.to_sentence.html_safe %>
        (the roles marked for browsers). The roles ticked here are this user's on top of those, with <code>${node}</code>
        its name <code><%= name %></code>: the router gives them only to the page the door connects with the user's
        certificate, never to the other browsers or to a page that comes through the shared connection.</p>
      <% if picks.empty? %><p class="hint">No other roles yet.</p><% end %>
      <%= f.collection_check_boxes :browser_role_ids, picks, :id, :name do |b| %>
        <label class="check role-pick"><%= b.check_box %>
          <span><strong><%= b.text %></strong>
            <span class="role-desc"><%= b.object.description.presence || tag.span("no description", class: "hint") %></span></span></label>
      <% end %>
    </fieldset>
    <div class="wide"><%= f.submit "Save" %> <%= link_to "Back", relay_browsers_path %></div>
  <% end %>
</section>
