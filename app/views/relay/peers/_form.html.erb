<% if peer.errors.any? %><p class="error"><%= peer.errors.full_messages.to_sentence %></p><% end %>
<%= form_with model: peer, url: peer.persisted? ? relay_peer_path(peer) : relay_peers_path, class: "grid-form" do |f| %>
  <label>Name (certificate CN = node ID)
    <%= f.text_field :name, required: true, disabled: peer.persisted?, pattern: "[A-Za-z0-9][A-Za-z0-9._\\-]{0,62}" %></label>
  <label title="The pages and the graph show it before the name: Tab5 (<%= peer.name.presence || "name" %>)">Display name (optional)
    <%= f.text_field :display_name, maxlength: RelayPeer::DISPLAY_NAME_MAX, placeholder: "Tab5" %></label>
  <label>Kind <%= f.select :kind, RelayPeer::KINDS %></label>
  <label>Certificate days <%= f.number_field :cert_days, min: 1, max: Relay::CertAuthority::LEAF_DAYS %></label>
  <label class="check"><%= f.check_box :enabled %> Enabled</label>
  <% if peer.kind == "router" %>
    <label class="check wide"><%= f.check_box :admin_space %> Console can see behind this router: the cloud router passes the
      console's status requests to this router (this router must also answer them in its own configuration,
      <code>adminspace</code> with read on)</label>
  <% else %>
    <label class="check wide"><%= f.check_box :admin_space %> May read the cloud router's status: every session connected to
      it and its address. Only for the console</label>
  <% end %>
  <fieldset class="wide roles">
    <legend>Roles (<%= link_to "what they allow", relay_roles_path %>)</legend>
    <% roles = RelayRole.order(:name) %>
    <% if roles.empty? %><p class="hint">No roles yet.</p><% end %>
    <%= f.collection_check_boxes :role_ids, roles, :id, :name do |b| %>
      <label class="check role-pick"><%= b.check_box %>
        <span><strong><%= b.text %></strong>
          <span class="role-desc"><%= b.object.description.presence || tag.span("no description", class: "hint") %></span></span></label>
    <% end %>
  </fieldset>
  <fieldset class="wide files">
    <legend>Files with the console (<%= link_to "Files", transfers_path %>), for the nodes it speaks for</legend>
    <label class="check"><%= f.check_box :files_to_console %> May send files to the console: the console takes them
      (<code>asend <%= ENV.fetch("ASTERISM_CONSOLE_NODE", "console") %> &lt;file&gt;</code> on the machine) and the ACL lets it call
      <code>asterism/<%= ENV.fetch("ASTERISM_CONSOLE_NODE", "console") %>/transfer/inbox/call/&lt;node&gt;</code></label>
    <label class="check"><%= f.check_box :files_from_console %> Receives files from the console: the Files page may send to it
      and the ACL gives it <code>asterism/&lt;node&gt;/transfer</code> and <code>asterism/&lt;node&gt;/transfer/**</code>
      (the machine takes them only when its <code>/home/asterism/receive.toml</code> has
      <code>[file] from = ["<%= ENV.fetch("ASTERISM_CONSOLE_NODE", "console") %>"]</code>, or the console is ticked
      under "Receives files from" below)</label>
  </fieldset>
  <fieldset class="wide files receivers">
    <legend>Receives files from (the machines of this row keep the list in their
      <code>/home/asterism/receive.toml</code>; the console sends it to them)</legend>
    <% choices = RelayPeer.sender_choices(except: peer) %>
    <% { "file" => [ :receive_files_from, "Files (to /home/inbox)" ],
         "checkpoint" => [ :receive_checkpoints_from, "Apps moved here (checkpoint)" ] }.each do |kind, (column, title)| %>
      <% chosen = peer.receivers(kind) %>
      <div class="receive-kind" data-kind="<%= kind %>">
        <strong><%= title %></strong>
        <% if choices.empty? %><p class="hint">No other members yet.</p><% end %>
        <% choices.each do |label, node| %>
          <label class="check"><%= check_box_tag "relay_peer[#{column}_picked][]", node, chosen.include?(node),
                                                 id: "#{column}_#{node.parameterize(separator: '_')}" %> <%= label %></label>
        <% end %>
        <%= hidden_field_tag "relay_peer[#{column}_picked][]", "", id: nil %>
        <label>Patterns and other nodes (one per line: <code>fmruby-*</code>, <code>*</code> for every member)
          <%= text_area_tag "relay_peer[#{column}_more]", (chosen - choices.map(&:last)).join("\n"), rows: 2,
                            id: "#{column}_more" %></label>
      </div>
    <% end %>
    <p class="hint">Each node chosen may call the inbox of this row's nodes
      (<code>asterism/&lt;node&gt;/transfer/inbox/call/&lt;sender&gt;</code>, made on Apply), and the machine takes what
      it sends; what the owner wrote by hand in <code>receive.toml</code> is taken too. A machine keeps the last list
      it was sent while the console cannot be reached. It takes the list only over a connection with its
      certificate (a <code>tls/</code> router).</p>
  </fieldset>
  <label class="wide">Description <%= f.text_field :description %></label>
  <label>Other keys it may read and write, outside its roles (one per line)
    <%= f.text_area :rw_keys, rows: 4 %></label>
  <label>Other keys it may only read, outside its roles (one per line)
    <%= f.text_area :ro_keys, rows: 4 %></label>
  <label>Nodes it speaks for (<code>${node}</code> of its roles; one node ID per line; empty: its own name.
    A router lists the nodes behind it)
    <%= f.text_area :nodes, rows: 3, placeholder: "node-a" %></label>
  <label>DNS names in its certificate (a router that listens; one per line)
    <%= f.text_area :dns_names, rows: 3 %></label>
  <label>IP addresses in its certificate (one per line)
    <%= f.text_area :ip_addresses, rows: 3 %></label>
  <p class="hint wide">Reading a key also lets it query that key, and an Asterism method call is a query:
    read-only on <code>asterism/**</code> still lets it call methods. A wider subscription than the keys
    allowed is refused whole. Keys starting with <code>@</code> are not in <code>**</code>.
    Most rows need no keys here: their roles say what they may do. Keys here are for what is not a role
    (the console's own <code>asterism/**</code>, for example); they are not limited to its nodes.</p>
  <%= f.submit peer.persisted? ? "Save" : "Register" %>
<% end %>
