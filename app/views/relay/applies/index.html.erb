<% content_for(:title, "Applies - Asterism Console") %>
<%= render "relay/peers/tabs" %>
<section class="card">
  <h2>Applies</h2>
  <% if @applies.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>#</th><th>When</th><th>Who</th><th>Status</th><th>Joining</th><th>Leaving</th><th>Digest</th></tr></thead>
      <tbody>
        <% @applies.each do |a| %>
          <tr>
            <td><%= link_to a.id, relay_apply_path(a) %></td>
            <td class="nowrap"><%= when_text(a.created_at) %></td>
            <td><%= a.user&.email_address %></td>
            <td><span class="badge <%= { 'ok' => 'ok', 'failed' => 'bad' }[a.status] || 'warn' %>"><%= a.status %></span></td>
            <td><%= a.plan["joining"].to_a.join(", ") %></td>
            <td><%= a.plan["leaving"].to_a.join(", ") %></td>
            <td><code><%= a.config_digest %></code></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
