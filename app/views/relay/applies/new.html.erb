<% content_for(:title, "Apply - Asterism Console") %>
<%= render "relay/peers/tabs" %>
<section class="card">
  <h2>Apply the registry to the cloud router</h2>
  <% if @plan["same_config"] %>
    <p class="hint">The file already holds this registry; applying again only restarts the router.</p>
  <% end %>
  <%= render "cut", plan: @plan %>
  <%= render "plan", plan: @plan %>
  <% if current_user.admin? %>
    <div class="stack">
      <%= button_to "Write the configuration and restart the cloud router now", relay_applies_path,
                    params: { mode: "now" }, disabled: @running,
                    form: { data: { turbo_confirm: "Restart the cloud router now? Every link to it is cut for a few seconds." } } %>
      <%= button_to "Apply when nobody is connected", relay_applies_path, params: { mode: "idle" } %>
      <%= form_with url: relay_applies_path, class: "row", data: { controller: "tz" } do |f| %>
        <%= f.hidden_field :mode, value: "at" %>
        <%= f.hidden_field :tz_offset, value: "", data: { tz_target: "offset" } %>
        <label>Apply at <%= f.datetime_local_field :run_at, required: true, data: { tz_target: "time" } %></label>
        <span class="hint" data-tz-target="zone">(UTC, unless this page knows your time zone)</span>
        <%= f.submit "Apply at this time" %>
      <% end %>
    </div>
    <p class="hint">The last two wait (the registry pages say so) and can be cancelled; they apply the registry as it is
      when they run. A new apply replaces one that waits.</p>
    <% if @waiting %><div class="notice-bar"><%= render "waiting", apply: @waiting %></div><% end %>
  <% else %>
    <p class="hint">Only an admin can apply.</p>
  <% end %>
</section>
<section class="card">
  <h2>The configuration (digest <%= @config.digest %>)</h2>
  <pre class="config"><%= @config.text(by: current_user.email_address) %></pre>
</section>
