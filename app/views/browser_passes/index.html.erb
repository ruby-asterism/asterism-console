<% content_for(:title, "Make a pass - Asterism Console") %>
<% if BrowserPage.enabled? %>
  <section class="card">
    <h2>Launch Web Studio</h2>
    <% if current_user.handle.blank? %>
      <p>A browser page joins the network as <code><%= Relay::Settings.browser_node_prefix %>&lt;handle&gt;</code>, a short name
        you choose. Every node on the network sees it. <%= link_to "Choose your handle", account_path(anchor: "handle") %> first.</p>
    <% else %>
      <p>Opens <code><%= BrowserPage.origin %></code> in a new tab, connected to this console's router with a fresh
        pass, as the node <code><%= @next_node %></code> (yours; a second page open at the same time gets the next name).</p>
      <%= form_with url: open_browser_passes_path, method: :post, data: { turbo: false }, html: { target: "_blank" } do |f| %>
        <label>Start <%= f.select :app, BrowserPage.apps %></label>
        <%= f.submit "Launch Web Studio" %>
      <% end %>
    <% end %>
  </section>
<% end %>
<section class="card">
  <h2>Make a pass</h2>
  <p>A pass lets a browser build (a page that joins the network from a browser) connect to this console's router over <code>wss://</code>.
    It is yours: the connections it opens are logged with your name. The first page that uses it, within
    <%= (BrowserPass::TTL / 60).to_i %> minutes, takes it: for <%= (BrowserPass::LIFETIME / 3600.0).round(1) %> hours from then
    that page may connect again (after the router restarts, or the line drops), and no other page can use it.
    After that, or after a reload (a new page), it needs a new pass.</p>
  <% if current_user.handle.blank? %>
    <p>A pass is for a node named after your handle (<code><%= Relay::Settings.browser_node_prefix %>&lt;handle&gt;</code>).
      <%= link_to "Choose your handle", account_path(anchor: "handle") %> first.</p>
  <% else %>
    <p>The next pass is for the node <code><%= @next_node %></code>: the page joins the network under that name.</p>
    <%= button_to "Make a pass", browser_passes_path, data: { turbo: false } %>
  <% end %>
</section>

<% if @new_pass %>
  <section class="card">
    <h2>New pass (shown once)</h2>
    <dl class="facts">
      <dt>Until</dt><dd><%= when_text(@new_pass.expires_at) %></dd>
      <dt>Pass</dt><dd><code class="wrap"><%= @new_pass.token %></code></dd>
      <dt>Node</dt><dd><code class="node"><%= @new_pass.node %></code></dd>
      <dt>Router</dt><dd><code><%= PassLink.router || "(ASTERISM_PASS_ROUTER is not set)" %></code></dd>
      <% if @link %><dt>Link</dt><dd><%= link_to @link, @link, rel: "noreferrer", target: "_blank", class: "wrap" %></dd><% end %>
    </dl>
    <% unless @link %>
      <p class="hint">Give the page both the pass and the node: a page with a pass but no node does not connect.</p>
    <% end %>
    <p class="hint">Do not share the link: whoever opens it first connects as you (and keeps it for that page). Revoke it below when you will not use it.</p>
  </section>
<% end %>

<section class="card">
  <h2>Your passes</h2>
  <% if @passes.empty? %>
    <p class="hint">None yet.</p>
  <% else %>
    <table class="list">
      <thead><tr><th>#</th><th>Node</th><th>Made</th><th>Until</th><th>Status</th><th>Connections</th><th>Last used</th><th>Refused</th><th></th></tr></thead>
      <tbody>
        <% @passes.each do |p| %>
          <tr>
            <td><%= p.id %></td>
            <td><%= p.node ? tag.code(p.node) : "-" %><%= tag.span(" #{p.app}", class: "hint") if p.app %></td>
            <td class="nowrap"><%= when_text(p.created_at) %></td>
            <td class="nowrap"><%= when_text(p.open_until || p.expires_at) %></td>
            <td><span class="badge <%= %w[live open].include?(p.status) ? 'ok' : 'bad' %>"><%= p.status %></span></td>
            <td><%= p.uses %></td>
            <td class="nowrap"><%= p.last_used_at ? "#{when_text(p.last_used_at)} from #{p.last_used_ip}" : "-" %></td>
            <td><%= p.refused %></td>
            <td><%= button_to "Revoke", revoke_browser_pass_path(p), method: :patch, class: "small" if p.revocable? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
