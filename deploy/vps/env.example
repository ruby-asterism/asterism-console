# deploy/vps/.env (copy this file to .env, chmod 600, fill in; never commit
# .env). docker compose reads it for the ${...} below, and the console and
# bridge get every line as their environment.

# --- names (use yours; these are placeholders) ---
# The console's name (nginx server_name, Certbot): DNS rebinding protection
# and the origin Action Cable accepts.
CONSOLE_HOSTS=asterism.example.org
# The router's locator for the browser build (nginx's wss:// port) and for
# boards / CRuby (zenohd's own mutual-TLS port).
ASTERISM_PASS_ROUTER=ws/router.example.org:7443
ASTERISM_RELAY_PUBLIC_ENDPOINT=tls/router.example.org:7448
# The browser build the pass links open.
ASTERISM_STUDIO_URL=https://family-mruby.github.io/studio/

# --- ports on the host (pick free ones; nginx points at the two loopback ones) ---
CONSOLE_PORT=3000
ROUTER_WS_PORT=7449
ROUTER_TLS_PORT=7448
ROUTER_TLS_BIND=0.0.0.0
# How long a browser's WebSocket may stay open (seconds) before the door
# (bin/ws_door) closes it; the browser then needs a fresh pass.
WS_DOOR_MAX_SECONDS=14400
# The router's certificate name (ROUTER_NAME = its metadata/name).
ROUTER_NAME=zenohd-vps

# --- secrets (make them on the server; README "Secrets") ---
SECRET_KEY_BASE=
ASTERISM_SIGNER_TOKEN=

# --- guards ---
# Admin pages answer only from these networks (on top of nginx's allow list);
# empty: nginx alone limits them.
CONSOLE_ADMIN_NETS=
CONSOLE_ADMIN_TOTP=required
# Seconds a browser pass opens connections (from when it is made).
ASTERISM_PASS_TTL=600
# Camera pictures in the watch panel, at most this many a second per key.
ASTERISM_WATCH_HEAVY_RATE=2
# Connection limits of the router (zenoh 1.10.1 transport/unicast).
ASTERISM_RELAY_MAX_SESSIONS=64
ASTERISM_RELAY_ACCEPT_PENDING=16
ASTERISM_RELAY_ACCEPT_TIMEOUT=5000
# The app whose keys players may use (asterism/<node>/<game>/**). Provisional
# until G1 settles the game's app name.
ASTERISM_RELAY_GAME=game

RAILS_LOG_LEVEL=info
