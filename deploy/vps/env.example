# deploy/vps/.env: copy this file to .env, chmod 600, fill in (never commit
# .env). docker compose reads it for the ${...} of docker-compose.yml, and
# the console, the bridge and the setup get every line as their
# environment. docs/install.md goes through it line by line.

# --- the console's image (docs/install.md, "Updating") ---
# The published image and its version (a tag of ghcr.io/ruby-asterism/
# asterism-console). Change the version, docker compose pull, up -d.
CONSOLE_IMAGE=ghcr.io/ruby-asterism/asterism-console
CONSOLE_VERSION=0.1.1

# --- your names (these are placeholders: put your own) ---
# The console's name (the web server's name for it, its TLS certificate):
# the only Host the console answers, and the origin its live updates accept.
CONSOLE_HOSTS=asterism.example.org
# Where routers, boards and CRuby reach the router (its own mutual-TLS port,
# straight to zenohd): goes into every certificate's asterism.json and
# example configuration, and the router's certificate names this host.
ASTERISM_RELAY_PUBLIC_ENDPOINT=tls/router.example.org:7448
# Where browser pages reach the router (the web server's wss:// port for the
# door, with a pass).
ASTERISM_PASS_ROUTER=ws/router.example.org:7443
# The cloud router's name: its certificate's name and metadata/name (the
# console finds it in the graph by it). Keep it once chosen.
ROUTER_NAME=zenohd-cloud
# More names / addresses the router's certificate is valid for (comma
# separated), besides the name in ASTERISM_RELAY_PUBLIC_ENDPOINT and
# "zenohd" (bin/asterism setup issues it).
# ASTERISM_RELAY_EXTRA_DNS=
# ASTERISM_RELAY_EXTRA_IPS=

# --- a page that joins the network from a browser (optional) ---
# "Open the browser build" opens it with a fresh pass, a node ID tied to the
# user and the app to start. Placeholders, filled in URL-encoded:
# {router} (ASTERISM_PASS_ROUTER), {pass} (must be after the #), {node},
# {app}. Unset: no such button; passes are still shown, without a link.
# ASTERISM_BROWSER_PAGE=https://play.example.org/?zenoh={router}#zenoh_pass={pass}&zenoh_node={node}&app={app}
# The browsers' node IDs start with this ({node} = <prefix><handle>; the ACL
# writes the browsers' ${node} as <prefix>$*).
# ASTERISM_BROWSER_NODE_PREFIX=wasm-

# --- ports on the host (pick free ones; the web server points at the two loopback ones) ---
CONSOLE_PORT=3000
ROUTER_WS_PORT=7449
ROUTER_TLS_PORT=7448
ROUTER_TLS_BIND=0.0.0.0
# How long a browser's WebSocket may stay open at most (seconds) before the
# door closes it; it also closes it when its pass closes
# (ASTERISM_PASS_LIFETIME, below). Keep the two equal.
WS_DOOR_MAX_SECONDS=14400

# --- secrets (make them on the server: docs/install.md, "Settings") ---
SECRET_KEY_BASE=
ASTERISM_SIGNER_TOKEN=

# --- how people get in ---
# admin: an admin registers every router and node and invites every user
# (the only mode for now; "approval" and "self" are planned, docs/o1.md).
ASTERISM_ENROLLMENT=admin
# Admin pages answer only from these networks (comma separated CIDRs), on
# top of the web server's own allow list; empty: the web server alone limits them.
CONSOLE_ADMIN_NETS=
CONSOLE_ADMIN_TOTP=required
# Seconds a browser pass waits for its page's first connection.
ASTERISM_PASS_TTL=600
# Seconds the page that took a pass may connect again with it (after the
# router restarts), from its first connection.
ASTERISM_PASS_LIFETIME=14400
# Days a handle that someone gave up stays reserved for them.
ASTERISM_HANDLE_HOLD_DAYS=30

# --- limits ---
# Camera pictures in the watch panel, at most this many a second per key.
ASTERISM_WATCH_HEAVY_RATE=2
# Connection limits of the router (zenoh 1.10.1 transport/unicast).
ASTERISM_RELAY_MAX_SESSIONS=64
ASTERISM_RELAY_ACCEPT_PENDING=16
ASTERISM_RELAY_ACCEPT_TIMEOUT=5000

RAILS_LOG_LEVEL=info
