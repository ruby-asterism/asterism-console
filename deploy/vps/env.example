# deploy/vps/.env: copy this file to .env, chmod 600, fill in (never commit
# .env). docker compose reads it for the ${...} of docker-compose.yml, and
# the console, the bridge and the setup get every line as their
# environment. docs/install.md goes through it line by line.

# --- the console's image (docs/install.md, "Updating") ---
# The published image and its version (a tag of ghcr.io/ruby-asterism/
# asterism-console). ./update.sh <version> changes it (with a backup, the
# checkout, the pull, the setup and the restart).
CONSOLE_IMAGE=ghcr.io/ruby-asterism/asterism-console
CONSOLE_VERSION=0.3.4

# --- the console's time zone (0.2.1) ---
# The pages show every time in this zone (the server's pages and the
# graph, timelines, logs and plots in the browser): a Rails or IANA name,
# e.g. Asia/Tokyo, Europe/Berlin, America/New_York. UTC unless set.
# (The daily backup's hour is the container's time, TZ, below.)
CONSOLE_TIME_ZONE=UTC

# --- backups of the console's databases (docs/install.md, "Backups") ---
# The "backup" service copies them into the "backups" volume once a day at
# this hour (0-23, UTC unless TZ is set, e.g. TZ=Asia/Tokyo) and keeps the
# newest ASTERISM_BACKUP_KEEP (update.sh's and hand-made ones count too).
ASTERISM_BACKUP_HOUR=3
ASTERISM_BACKUP_KEEP=7

# --- your names (these are placeholders: put your own) ---
# The console's name (the web server's name for it, its TLS certificate):
# the only Host the console answers, and the origin its live updates accept.
CONSOLE_HOSTS=asterism.example.org
# Where routers, boards and CRuby reach the router (its own mutual-TLS port,
# straight to zenohd): goes into every certificate's asterism.json and
# example configuration, and the router's certificate names this host.
ASTERISM_RELAY_PUBLIC_ENDPOINT=tls/router.example.org:7448
# Where browser pages reach the router (the web server's wss:// port for the
# door, with a pass).
ASTERISM_PASS_ROUTER=ws/router.example.org:7443
# The cloud router's name: its certificate's name and metadata/name (the
# console finds it in the graph by it). Keep it once chosen.
ROUTER_NAME=zenohd-cloud
# More names / addresses the router's certificate is valid for (comma
# separated), besides the name in ASTERISM_RELAY_PUBLIC_ENDPOINT and
# "zenohd" (bin/asterism setup issues it).
# ASTERISM_RELAY_EXTRA_DNS=
# ASTERISM_RELAY_EXTRA_IPS=

# --- a page that joins the network from a browser (optional) ---
# "Open the browser build" opens it with a fresh pass, a node ID tied to the
# user (wasm-<handle>) and the app to start; the link a pass is shown with
# has the same form. Placeholders, filled in URL-encoded:
# {router} (ASTERISM_PASS_ROUTER), {pass} (must be after the #), {node}
# (must be there: every link names the node), {app}. Unset: no such button;
# a pass is shown with its node, without a link.
# ASTERISM_BROWSER_PAGE=https://play.example.org/?zenoh={router}#zenoh_pass={pass}&zenoh_node={node}&app={app}
# The browsers' node IDs start with this ({node} = <prefix><handle>; the ACL
# writes the browsers' ${node} as <prefix>$*).
# ASTERISM_BROWSER_NODE_PREFIX=wasm-

# --- rooms (G2, docs/rooms.md) ---
# A room is a key space of its own (room/<slot>/**) that anyone with its
# link joins from a browser, without an account, for a few hours. The link
# is the page below with the room's key in its fragment. Placeholders,
# filled in URL-encoded: {router} (ASTERISM_PASS_ROUTER; the page goes to
# its /room path), {room} (must be after the #), {app}. Unset: a room's key
# is shown alone.
# ASTERISM_ROOM_PAGE=https://play.example.org/?zenoh={router}#room={room}&app={app}
# What a room's link may open, offered first on the rooms' page
# ("Label=/path", comma separated; the roles' browser apps follow). A game
# host next to the console (asterism-games) serves tables in the rooms that
# open its table (docker-compose.games.yml, docs/install.md "A game host").
ASTERISM_ROOM_APPS=Othello=/app/test/othello.app.rb,Mahjong=/app/game/mahjong/mahjong.app.rb
# Room slots (rooms open at once; 0: no rooms): bin/asterism setup makes
# their seats' certificates, then apply. Changing it needs setup and an apply.
ASTERISM_ROOM_SLOTS=8
# Hours a room is open unless the admin says otherwise, and the longest (at most 24).
ASTERISM_ROOM_DEFAULT_HOURS=3
ASTERISM_ROOM_MAX_HOURS=24
# Connections a room may have at once (at most 16: a table of 4 and 12 watching).
ASTERISM_ROOM_MAX_CONNECTIONS=16
# Seats per slot (0.3.0, docs/rooms.md "Seats", 1..99): a certificate each
# (room-01-s01 .., in the rooms' volume, not the registry), so the router
# binds every page in a room to its own node ID (wasm-0101 ..). bin/asterism
# setup makes them, then apply.
ASTERISM_ROOM_SEATS=16
# Game hosts that join the rooms with their own certificate (a registry row
# of that name, asterism-games' "games"): the rooms' tables under
# asterism/<host>... are theirs only. "-": none.
ASTERISM_ROOM_HOSTS=games
# The door: room connections at once, all rooms together, and per room.
WS_DOOR_ROOM_TOTAL=48
WS_DOOR_ROOM_PER_ROOM=16
# A seat nobody has been connected on for this long (seconds) may go to
# another page when every seat of the room is taken.
WS_DOOR_SEAT_IDLE=1800

# --- ports on the host (pick free ones; the web server points at the three loopback ones) ---
CONSOLE_PORT=3000
ROUTER_WS_PORT=7449
ROOM_DOOR_PORT=7452
ROUTER_TLS_PORT=7448
ROUTER_TLS_BIND=0.0.0.0
# How long a browser's WebSocket may stay open at most (seconds) before the
# door closes it; it also closes it when its pass closes
# (ASTERISM_PASS_LIFETIME, below). Keep the two equal.
WS_DOOR_MAX_SECONDS=14400

# --- secrets (make them on the server: docs/install.md, "Settings") ---
SECRET_KEY_BASE=
ASTERISM_SIGNER_TOKEN=

# --- how people get in ---
# admin: an admin registers every router and node and invites every user
# (the only mode for now; "approval" and "self" are planned, docs/o1.md).
ASTERISM_ENROLLMENT=admin
# Admin pages answer only from these networks (comma separated CIDRs), on
# top of the web server's own allow list; empty: the web server alone limits them.
CONSOLE_ADMIN_NETS=
CONSOLE_ADMIN_TOTP=required
# Seconds a browser pass waits for its page's first connection.
ASTERISM_PASS_TTL=600
# Seconds the page that took a pass may connect again with it (after the
# router restarts), from its first connection.
ASTERISM_PASS_LIFETIME=14400
# Days a handle that someone gave up stays reserved for them.
ASTERISM_HANDLE_HOLD_DAYS=30

# --- limits ---
# Camera pictures in the watch panel, at most this many a second per key.
ASTERISM_WATCH_HEAVY_RATE=2
# Connection limits of the router (zenoh 1.10.1 transport/unicast). 96 from
# 0.2.0: the rooms' connections (WS_DOOR_ROOM_TOTAL) come on top of the others.
ASTERISM_RELAY_MAX_SESSIONS=96
ASTERISM_RELAY_ACCEPT_PENDING=16
ASTERISM_RELAY_ACCEPT_TIMEOUT=5000

# The router watch (0.3.2, docs/install.md section 21): the bridge opens a new
# session to the router this often (seconds; 0: off), allows the timeout for
# it to open, and asks for the router's restart (as Apply does) after this
# many failures in a row. Nothing is counted for the grace after a restart
# request or an apply.
# ASTERISM_RELAY_WATCH_EVERY=30
# ASTERISM_RELAY_WATCH_TIMEOUT=10
# ASTERISM_RELAY_WATCH_FAILS=2
# ASTERISM_RELAY_WATCH_GRACE=60

RAILS_LOG_LEVEL=info
